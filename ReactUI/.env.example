# Public storefront URL (used for canonical links, OG URLs, sitemap).

# Leave empty in development — the app uses window.location.origin.

# VITE_SITE_URL=https://dibagallery.com



# Backend URL for SSR loaders (Node fetch during server render).

# Required when running `npm run dev:ssr`, `npm run build:seo`, or `npm run start:ssr`.

SSR_API_TARGET=https://localhost:60927



# Optional explicit API base for client build (defaults to same-origin /api proxy).

# VITE_API_BASE_URL=



# Optional Core Web Vitals POST endpoint (requires web-vitals package if used)

# VITE_WEB_VITALS_ENDPOINT=

# Full SEO build: client + SSR + prerender for static routes (npm run build:seo)
