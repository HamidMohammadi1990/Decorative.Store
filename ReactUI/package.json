{
  "name": "westelm-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "node server/ssr.mjs",
    "build": "tsc -b && vite build",
    "build:ssr": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:seo": "npm run build:ssr && node scripts/prerender.mjs",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:ssr": "cross-env NODE_ENV=production node server/ssr.mjs",
    "download:images": "node scripts/download-home-images.mjs",
    "download:images:placeholders": "node scripts/download-home-images.mjs --placeholders"
  },
  "dependencies": {
    "i18next": "^26.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.17.0",
    "web-vitals": "^4.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "compression": "^1.8.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^4.21.2",
    "globals": "^17.6.0",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
