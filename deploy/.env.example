# Copy to deploy/.env and fill before: docker compose --env-file .env up -d --build

# Block search engines until launch (meta noindex + robots.txt Disallow: /)
BLOCK_SEARCH_INDEXING=true

# Public URL (browser + CORS + storefront links) — must match exactly what users type in the browser.
# Example with custom port: http://185.213.167.240:3032
PUBLIC_SITE_URL=http://185.213.167.240:3032

# Host header allowed by ASP.NET (comma-separated or * behind nginx)
ALLOWED_HOSTS=*

# Port published on the VPS (nginx → web/api inside Docker)
HTTP_PORT=3032

# SQL Server (Linux container)
MSSQL_PID=Express
MSSQL_DATABASE=DecorativeStoreDB
# Must meet SQL complexity: 8+ chars, upper, lower, number, symbol
MSSQL_SA_PASSWORD=ChangeMe_Strong_Passw0rd!

# Redis
REDIS_PASSWORD=ChangeMe_Redis_Secret!

# First deploy only: apply EF migrations + seed admin permissions, then set both to false
DATABASE_APPLY_MIGRATIONS=true
DATABASE_SEED_PERMISSIONS=true

# JWT (min 32 chars for SecretKey; EncryptKey exactly 16 chars for AES)
JWT_SECRET_KEY=719A536AE1E741CA9522BC7191FFAAC7_CHANGE_ME
JWT_ENCRYPT_KEY=A3542E3F365AC57A

# Entity encryption general key (match production policy)
SECURITY_GENERAL_KEY=D7CBD35D42D642DAA164207A
